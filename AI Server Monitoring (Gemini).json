      "id": "ae632883-1ea9-46d6-ba8e-323d3a372b26",
      "name": "Cek Server (PowerShell)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1840,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== KONFIGURASI =====\nconst DEMO = true;   // true = threshold diturunkan supaya alert pasti muncul. Ubah ke false setelah demo.\n\nconst d = JSON.parse($input.first().json.stdout);\nconst T = DEMO\n  ? { cpu: 1, diskFree: 25, ram: 30, licenseDays: 90 }\n  : { cpu: 80, diskFree: 25, ram: 70, licenseDays: 90 };\n\nconst issues = [];\nif (d.cpu >= T.cpu) issues.push(`CPU tinggi: ${d.cpu}% (batas ${T.cpu}%)`);\nif (d.disk_free < T.diskFree) issues.push(`Disk sisa ${d.disk_free}% (min ${T.diskFree}%)`);\nif (d.ram > T.ram) issues.push(`RAM ${d.ram}% (maks ${T.ram}%)`);\nif (d.net !== 'Connected') issues.push('Koneksi timeout');\nif (d.svc !== 'Running') issues.push(`Service ${d.svc} (Down)`);\nif (d.errors > 0 || d.warnings > 0) issues.push(`${d.errors} error, ${d.warnings} warning dalam 1 jam terakhir`);\n\nconst daysLeft = Math.floor((new Date(d.license_expiry) - new Date()) / 86400000);\nif (daysLeft < T.licenseDays) issues.push(`License expire ${daysLeft} hari lagi`);\n\nconst prompt = `Kamu adalah engineer monitoring server. Berikut hasil health check:\n\nMetrik: CPU ${d.cpu}%, Disk free ${d.disk_free}%, RAM ${d.ram}%, Network ${d.net}, Service Spooler: ${d.svc}\nMasalah terdeteksi: ${issues.join('; ')}\nPotongan log (1 jam terakhir): ${d.logs || '(kosong)'}\n\nTugas: (1) rangkum masalah dalam 2 kalimat, (2) kemungkinan penyebab, (3) langkah troubleshooting berurutan beserta command-nya (Windows/PowerShell).\nGunakan nama service \"Spooler\" di command, jangan pakai placeholder.\nJawab singkat dalam bahasa Indonesia, tanpa markdown.`;\n\nconst aiBody = { contents: [{ parts: [{ text: prompt }] }] };\n\nreturn [{ json: { ...d, license_days_left: daysLeft, issues, hasIssue: issues.length > 0, aiBody } }];"
      },
